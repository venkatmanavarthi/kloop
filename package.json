{
  "name": "krackloop",
  "productName": "KrackLoop",
  "version": "0.1.0",
  "description": "Free, open-source interview practice for any field.",
  "license": "MIT",
  "private": true,
  "main": "dist/main.cjs",
  "scripts": {
    "postinstall": "bun node_modules/electron/install.js",
    "build": "bun scripts/build.ts",
    "start": "bun run build && electron .",
    "onboarding": "bun run build && bun scripts/onboarding.ts",
    "icon": "bun scripts/icon.ts",
    "web:dev": "bun website/index.html",
    "web:build": "bun scripts/build-web.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "electron": "^45.0.0",
    "typescript": "^7.0.2"
  }
}
